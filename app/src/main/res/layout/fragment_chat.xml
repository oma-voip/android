<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.chat.ChatFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar_"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/colorBackgroundDark"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:transitionName="actionBar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:minWidth="42dp"
            android:src="@drawable/ic_back"
            app:layout_constraintLeft_toLeftOf="parent"
            app:tint="@color/white"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/x3_def_padding"
            android:paddingEnd="@dimen/x2_def_padding"
            android:textAlignment="gravity"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toRightOf="@id/back_btn" />

        <ImageButton
            android:id="@+id/option_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/channel_option"
            android:minWidth="42dp"
            android:src="@drawable/ic_dots"
            app:layout_constraintRight_toRightOf="parent"
            app:tint="@color/white"
            tools:ignore="SpeakableTextPresentCheck" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:padding="0dp"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?android:attr/actionBarSize"
        android:background="@color/colorBackgroundDark"
        android:orientation="vertical">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/x2_def_padding"
            android:paddingTop="@dimen/x2_def_padding"
            android:paddingRight="@dimen/x2_def_padding"
            android:paddingBottom="70dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@layout/chat_message">


        </androidx.recyclerview.widget.RecyclerView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:id="@+id/files_selected_layout"
            android:visibility="gone"
            android:layout_height="wrap_content"
            app:layout_constraintRight_toRightOf="parent"
            android:paddingStart="@dimen/x2_def_padding"
            android:paddingEnd="@dimen/x2_def_padding"
            android:paddingTop="@dimen/x0.5_def_padding"
            android:paddingBottom="@dimen/x0.5_def_padding"
            android:layout_marginEnd="@dimen/x2_def_padding"
            android:background="@drawable/bg_clear_files"
            app:layout_constraintBottom_toTopOf="@id/layout_send_message">

            <TextView
                android:id="@+id/files_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="files: 4" />

            <ImageButton
                android:layout_marginStart="@dimen/x2_def_padding"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_cancel"
                android:id="@+id/clear_file_btn"
                android:background="@color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_send_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient"
            android:orientation="horizontal"
            android:padding="@dimen/x2_def_padding"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Oma.SendMessageBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                app:hintEnabled="false"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/message_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/message"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="@dimen/def_padding"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/attachment_btn"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_btn"
                android:contentDescription="@string/add_attachment"
                android:src="@drawable/ic_attachment_file"
                app:tint="@color/white" />

            <Space
                android:layout_width="@dimen/def_padding"
                android:layout_height="1dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/send_btn"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_btn"
                android:contentDescription="@string/add_attachment"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>




</androidx.coordinatorlayout.widget.CoordinatorLayout>