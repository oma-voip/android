<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/def_padding"
        android:layout_marginTop="@dimen/def_padding"
        android:drawablePadding="@dimen/def_padding"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:padding="@dimen/x2_def_padding"
        android:text="general"
        android:textSize="16sp"
        app:drawableStartCompat="@drawable/ic_text_channel"

        app:drawableTint="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:id="@+id/tvMemberList"
        android:visibility="gone"
        android:layout_marginStart="@dimen/x4_def_padding"
        android:layout_height="wrap_content">


    </LinearLayout>
</LinearLayout>