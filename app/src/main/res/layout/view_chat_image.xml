<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/transparent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/test_image"
        android:adjustViewBounds="true"
        android:transitionName="shared_image"
        android:contentDescription="@string/image" />


    <ImageButton
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:id="@+id/view_chat_image_image"
        android:layout_width="@dimen/image_download_button"
        android:layout_height="@dimen/image_download_button"
        android:background="@drawable/circular"
        android:src="@drawable/ic_download"
        android:scaleType="centerCrop"
        android:elevation="@dimen/x2_def_padding"
        android:padding="@dimen/x3_def_padding"
        app:tint="@color/white" />


    <ProgressBar
        android:visibility="gone"
        android:elevation="@dimen/x2_def_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:id="@+id/view_chat_image_progress"
        android:layout_width="@dimen/image_download_button"
        android:layout_height="@dimen/image_download_button"
        android:background="@drawable/circular"
        android:padding="@dimen/x3_def_padding"
        android:progressTint="@color/white"
        android:progress="20" />

</androidx.constraintlayout.widget.ConstraintLayout>