<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="4dp">

    <com.devrj.superellipse.SuperEllipseImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:id="@+id/tv_server_ellipse"
        app:shapeBackgroundColor="@color/colorContrastBackground"
        app:shapeBorderWidth="0dp"

        android:gravity="center" />

    <TextView
        android:id="@+id/tv_server_letter"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="D" />

    <TextView
        android:id="@+id/badge"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="@drawable/badge_server_bg"
        android:gravity="center"
        android:textColor="@color/white"
        android:visibility="gone" />

</FrameLayout>