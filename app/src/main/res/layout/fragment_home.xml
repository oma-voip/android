<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_servers"
        android:layout_width="73dp"
        android:layout_height="match_parent"
        android:padding="@dimen/x0.5_def_padding"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:listitem="@layout/item_server" />

    <!--    <com.google.android.material.divider.MaterialDivider-->
    <!--        android:id="@+id/divider"-->
    <!--        android:layout_width="@dimen/divider"-->
    <!--        android:layout_height="match_parent"-->
    <!--        app:layout_constraintLeft_toRightOf="@id/rv_servers"-->
    <!--        android:orientation="vertical" />-->

    <LinearLayout
        android:id="@+id/channel_menu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main"
        android:visibility="visible"
        app:layout_constraintLeft_toRightOf="@id/rv_servers"
        android:orientation="vertical"
        app:layout_constraintRight_toRightOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:id="@+id/action_bar_"
            android:orientation="horizontal"
            android:layout_height="?android:attr/actionBarSize">

            <TextView
                android:id="@+id/server_name"
                android:layout_width="match_parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="Sovamorco"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/x2_def_padding"
                android:layout_marginStart="16dp"
                android:textAlignment="gravity"

                android:gravity="center_vertical|start"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/def_padding"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/server_channels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"

            tools:listitem="@layout/item_channel" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>