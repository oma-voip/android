<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="me.sweettie.oma.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_chat"
            app:destination="@id/chatFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_main_to_joincreate_space"
            app:destination="@id/createSpaceFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_home_to_voicechat"
            app:destination="@id/voiceChatFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="me.sweettie.oma.ui.chat.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat">

        <action
            android:id="@+id/action_chat_to_members"
            app:destination="@id/membersFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <argument
            android:name="channelId"
            app:argType="string"
            app:nullable="false" />

        <argument
            android:name="serverId"
            app:argType="string"
            app:nullable="false" />


        <action
            android:id="@+id/action_chatFragment_to_voiceChatFragment"
            app:destination="@id/voiceChatFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/membersFragment"
        android:name="me.sweettie.oma.ui.members.MembersFragment"
        android:label="Members"
        tools:layout="@layout/fragment_members">


        <argument
            android:name="channelId"
            app:argType="string"
            app:nullable="false" />

        <argument
            android:name="serverId"
            app:argType="string"
            app:nullable="false" />

    </fragment>

    <fragment
        android:id="@+id/createSpaceFragment"
        android:name="me.sweettie.oma.ui.joincreatespace.JoinCreateSpaceFragment"
        android:label="join/create Space"
        tools:layout="@layout/fragment_joincreatespace" />

    <fragment
        android:id="@+id/voiceChatFragment"
        tools:layout="@layout/fragment_voice_chat"
        android:name="me.sweettie.oma.ui.voicechat.VoiceChatFragment"
        android:label="VoiceChatFragment">

        <action
            android:id="@+id/action_voicechat_to_members"
            app:destination="@id/membersFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <argument
            android:name="channelId"
            app:argType="string"
            app:nullable="false" />

        <argument
            android:name="serverId"
            app:argType="string"
            app:nullable="false" />

        <argument
            android:name="join"
            app:argType="boolean"
            app:nullable="false"
            android:defaultValue="false" />

    </fragment>

</navigation>